#!/bin/sh
# Sourced by the official nginx entrypoint before its envsubst phase.
set -eu

case "${POKER_PUBLIC_HOST:-}" in
    ''|*[!a-z0-9.-]*|.*|*..*|*.)
        echo "POKER_PUBLIC_HOST inválido" >&2
        exit 1
        ;;
esac
if [ "${#POKER_PUBLIC_HOST}" -gt 253 ]; then
    echo "POKER_PUBLIC_HOST excede 253 caracteres" >&2
    exit 1
fi

secret_file=/run/secrets/proxy_shared_secret
if [ ! -f "$secret_file" ] || [ -L "$secret_file" ]; then
    echo "proxy_shared_secret ausente ou não regular" >&2
    exit 1
fi

POKER_PROXY_SHARED_SECRET="$(tr -d '\r\n' < "$secret_file")"
case "$POKER_PROXY_SHARED_SECRET" in
    *[!0-9a-fA-F]*|'')
        echo "proxy_shared_secret deve ser hexadecimal" >&2
        exit 1
        ;;
esac
if [ "${#POKER_PROXY_SHARED_SECRET}" -ne 64 ]; then
    echo "proxy_shared_secret deve ter exatamente 64 caracteres hexadecimais" >&2
    exit 1
fi
export POKER_PROXY_SHARED_SECRET
